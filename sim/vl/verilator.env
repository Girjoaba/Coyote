# The Verilator this simulation needs. The one place for the pin: sim/vl/build.sh, sim/vl/install_verilator.sh,
# sim/container/install.sh and .github/workflows/run_simulation_verilator.yaml read it (shell syntax, sourced).
#
#   VERILATOR_REF  what install_verilator.sh builds: a release tag (v5.052) or a commit
#   VERILATOR_MIN  the oldest build that build.sh accepts, as `verilator --version` prints it after `rev`:
#                  a tag (v5.052), or <tag>-<commits after it> for a master build (v5.052-521)
#   verilator_rev  prints that `rev` value of the verilator in PATH (or of the binary given as $1):
#                  `v5.052` for a release, `v5.052-521-g6388139f7` for a master build 521 commits after it
#
# Why a commit: release 5.052 does not elaborate constant functions that return unpacked arrays
# (libstf global_config.sv); master commit 6388139f7 (521 commits after v5.052) does. 5.052 also loses
# a clocking drive after a mailbox wake (verilator/verilator#8771, fix in #8772); c_meta.svh and
# sim_params.svh work around it. Master since #8772 also raises BLKANDNBLK on clocking block outputs
# the testbench drives with <= (a false positive, fix sent upstream); build.sh passes -Wno-BLKANDNBLK.
# With the first release that ships all three fixes, set both lines to its tag and drop the three
# workarounds.
VERILATOR_REF=6388139f7
VERILATOR_MIN=v5.052-521
verilator_rev() {
    "${1:-verilator}" --version 2>/dev/null | awk '{for (i = 1; i < NF; i++) if ($i == "rev") print $(i + 1)}'
}
